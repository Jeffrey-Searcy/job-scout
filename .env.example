# Copy to .env before running `docker compose up`.
# Postgres credentials (used by the db service and the DATABASE_URL below).
POSTGRES_DB=jobscout
POSTGRES_USER=jobscout
POSTGRES_PASSWORD=jobscout

# Django connection + settings.
DATABASE_URL=postgres://jobscout:jobscout@db:5432/jobscout
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Host ports (change if something else already uses these).
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Set to 1 to load generic SAMPLE data on first boot (demo only).
SEED_SAMPLE=0
APP_TITLE=Job Scout
